generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserSettings {
  id                    String   @id @default("default")
  uiLanguage            String   @default("de")
  responseLanguage      String   @default("de")
  timezone              String   @default("Europe/Berlin")
  notifyInAppDueTasks        Boolean  @default(false)
  notifyBrowserDueTasks      Boolean  @default(false)
  calendarIntegrationEnabled Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model CalendarConnection {
  id           String    @id @default("default")
  provider     String    @default("google")
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  calendarId   String    @default("primary")
  accountEmail String?
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Kalender-Entwurf; Export nach Google wenn verbunden.
model ExternalCalendarDraft {
  id              String    @id @default(cuid())
  title           String
  startAt         DateTime
  endAt           DateTime?
  description     String?
  timezone        String?
  status          String    @default("draft")
  externalEventId String?
  exportError     String?
  exportedAt      DateTime?
  proposalId      String?   @unique
  createdAt       DateTime  @default(now())
}

model Conversation {
  id        String    @id @default(cuid())
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  actions   ActionProposal[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  metadata       String?
  createdAt      DateTime     @default(now())
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("open")
  priority    String?
  dueDate     String?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Memory {
  id              String   @id @default(cuid())
  content         String
  category        String   @default("note")
  source          String
  sourceDetail    String?
  isActive        Boolean  @default(true)
  replacedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActionProposal {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  triggerMessageId String?
  actionType     String
  payload        String
  summary        String
  affectedData   String
  scope          String        @default("local")
  status         String        @default("awaiting_confirmation")
  idempotencyKey String        @unique
  resultPayload  String?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  executedAt     DateTime?
}

model DailyBriefing {
  id          String   @id @default(cuid())
  content     String
  generatedAt DateTime @default(now())
}

model DayPlan {
  id          String   @id @default(cuid())
  planDate    String
  intro       String?
  items       String
  isActive    Boolean  @default(true)
  source      String   @default("chat_confirmed")
  createdAt   DateTime @default(now())
  confirmedAt DateTime @default(now())
}
