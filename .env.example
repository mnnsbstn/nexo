# SQLite (paths relative to prisma/ unless absolute — see docs/HOSTING.md)
DATABASE_URL="file:./dev.db"

# Optional: enable live model responses (OpenAI-compatible API)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Server-only; never expose to the browser
NEXO_DEMO_MODE=auto

# Optional: Calendar OAuth (see docs/INTEGRATIONS.md)
# NEXO_PUBLIC_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Optional: separate key for OAuth token encryption (else NEXO_SESSION_SECRET / NEXO_AUTH_PASSWORD)
# NEXO_TOKEN_ENCRYPTION_KEY=

# Playwright only — mock Google export + /api/e2e/calendar/connection (never set on production)
# NEXO_E2E_CALENDAR_MOCK=1

# Optional: single-user login (recommended for any public/hosted deployment)
# Leave unset for local dev without login wall.
# NEXO_AUTH_PASSWORD=
# NEXO_SESSION_SECRET=change-me-to-a-long-random-string
