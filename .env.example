# SQLite database (local development)
DATABASE_URL="file:./dev.db"

# Optional: enable live model responses (OpenAI-compatible API)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Server-only; never expose to the browser
NEXO_DEMO_MODE=auto

# Optional: single-user login (recommended for any public/hosted deployment)
# Leave unset for local dev without login wall.
# NEXO_AUTH_PASSWORD=
# NEXO_SESSION_SECRET=change-me-to-a-long-random-string
